rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function participant(data) {
      return signedIn()
        && data.participantUserIds.hasAny([request.auth.uid]);
    }
    function dateOnly(value) { return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$'); }
    function notDeleting(data) { return !('deleting' in data) || data.deleting != true; }
    function validVisit(data) {
      return data.keys().hasOnly([
          'placeId','date','category','participantUserIds','tripId','level','kind','endDate','createdBy',
          'createdAt','updatedAt','deleting','deletingAt','sourceSpace','sourcePlaceId','sourceVisitKey'
        ])
        && data.placeId is string && data.placeId.size() > 0
        && dateOnly(data.date)
        && data.participantUserIds is list && data.participantUserIds.size() > 0
        && (!('level' in data) || data.level in ['經過','接地','旅遊','住宿','居住'])
        && data.kind in ['visit','stay']
        && (data.kind == 'visit' || (dateOnly(data.endDate) && data.endDate > data.date));
    }
    function validTrip(data) {
      return data.keys().hasOnly([
          'name','emoji','startDate','endDate','color','participantUserIds','createdBy',
          'createdAt','updatedAt','sourceSpace','sourceTripId'
        ])
        && data.name is string
        && data.participantUserIds is list && data.participantUserIds.size() > 0;
    }
    function visitNow(visitId) {
      return get(/databases/$(database)/documents/visits/$(visitId));
    }

    match /visits/{visitId} {
      allow get, list: if participant(resource.data);
      allow create: if participant(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && validVisit(request.resource.data)
        && notDeleting(request.resource.data);
      allow update: if participant(resource.data)
        && participant(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && validVisit(request.resource.data)
        && (
          (notDeleting(resource.data)
            && notDeleting(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting','deletingAt']))
          || (request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting','deletingAt','updatedAt']))
        );
      allow delete: if participant(resource.data)
        && request.auth.uid == resource.data.createdBy
        && resource.data.deleting == true;

      match /contributions/{contributionUid} {
        function currentVisit() { return visitNow(visitId); }
        function validContribution(data) {
          return data.keys().hasOnly(['rating','memory','level','updatedAt'])
            && (!('rating' in data) || data.rating == null
              || data.rating in [0.5,1,1.5,2,2.5,3,3.5,4,4.5,5])
            && (!('memory' in data) || data.memory is string)
            && (!('level' in data) || data.level is string);
        }
        allow get, list: if participant(currentVisit().data);
        allow create, update: if signedIn()
          && request.auth.uid == contributionUid
          && participant(currentVisit().data)
          && notDeleting(currentVisit().data)
          && validContribution(request.resource.data);
        allow delete: if signedIn() && (
          (request.auth.uid == contributionUid && participant(currentVisit().data) && notDeleting(currentVisit().data))
          || (participant(currentVisit().data) && request.auth.uid == currentVisit().data.createdBy && currentVisit().data.deleting == true)
        );
      }
    }

    match /trips/{tripId} {
      allow get, list: if participant(resource.data);
      allow create: if participant(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && validTrip(request.resource.data);
      allow update: if participant(resource.data)
        && participant(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && validTrip(request.resource.data);
      allow delete: if participant(resource.data) && request.auth.uid == resource.data.createdBy;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;

      match /dayOrders/{date} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      // Per-user friend address book (docs/FRIENDS.md). Owned entirely by the
      // user; a friend entry only makes a person selectable and carries no
      // Visit/Trip authority. Batch 1 uses state "linked" only.
      match /friends/{friendUid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nickname','pinned','state','createdAt'])
          && (!('nickname' in request.resource.data) || request.resource.data.nickname is string)
          && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool)
          && (!('state' in request.resource.data) || request.resource.data.state in ['linked','pending_out']);
      }
    }

    // Friend-request handshake (docs/FRIENDS.md). Doc id is "{from}__{to}".
    // Only the two parties can see it; the sender opens it as "pending", only
    // the recipient can move it to "accepted"/"declined", either can delete it.
    match /friendRequests/{requestId} {
      function party() {
        return signedIn()
          && (resource.data.get('from', '') == request.auth.uid
            || resource.data.get('to', '') == request.auth.uid);
      }
      allow get, list: if party();
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.keys().hasOnly(['from','to','state','createdAt']);
      allow update: if signedIn()
        && request.auth.uid == resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
        && request.resource.data.state in ['accepted','declined'];
      allow delete: if party();
    }

    // Public short friend codes (docs/FRIENDS.md). friendCodes/{code} -> { uid }.
    // Any signed-in user may resolve a code they were given; a user may claim a
    // code only for their own uid, and codes are permanent (no update/delete).
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /places/{placeId} {
      function objective(data) {
        return data.keys().hasOnly([
          'name','lat','lng','source','extId','admin','countyCode','townCode','villCode','createdBy','createdAt'
        ]);
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && objective(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && objective(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin','countyCode','townCode','villCode']);
      allow delete: if false;

      match /legacyImports/{importId} {
        allow get: if participant(resource.data);
        allow list, create, update, delete: if false;
      }
    }

    match /appConfig/{configId} {
      allow get: if signedIn() && configId == 'defaults';
      allow list, create, update, delete: if false;
    }

    match /migrations/{migrationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
